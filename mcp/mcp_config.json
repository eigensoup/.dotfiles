{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "gortex": {
      "command": "gortex",
      "args": [
        "mcp"
      ],
      "env": {
        "GORTEX_INDEX_WORKERS": "8"
      }
    },
    "headroom": {
      "command": "headroom",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "lean-ctx": {
      "command": "lean-ctx",
      "args": [
        "mcp"
      ]
    },
    "ponytail": {
      "command": "node",
      "args": [
        "/Users/eigensoup/.local/share/ponytail/ponytail-mcp/index.js"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "topos": {
      "command": "topos",
      "args": [
        "mcp"
      ]
    }
  }
}