# User npm config, linked to ~/.config/npm/npmrc by `es install` and found
# through NPM_CONFIG_USERCONFIG (.zshrc). Not ~/.npmrc: pnpm run from ~ takes
# that for a project's own .npmrc and ignores ${...} credentials in it.
# No secrets here: the token comes from the macOS Keychain via .zshrc.

# @krv-labs packages (e.g. @krv-labs/erdos-cli) live on GitHub Packages.
@krv-labs:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${KRV_PACKAGES_TOKEN}
