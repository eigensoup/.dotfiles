{
  "mcpServers": {
    "github": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command": "npx"
    },
    "gortex": {
      "args": [
        "mcp"
      ],
      "command": "gortex",
      "env": {
        "GORTEX_INDEX_WORKERS": "8"
      }
    },
    "headroom": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "headroom"
    },
    "lean-ctx": {
      "args": [
        "mcp"
      ],
      "command": "/Users/eigensoup/.local/bin/lean-ctx",
      "tools": [
        "*"
      ],
      "type": "local"
    },
    "ponytail": {
      "args": [
        "/Users/eigensoup/.local/share/ponytail/ponytail-mcp/index.js"
      ],
      "command": "node"
    },
    "pulsar": {
      "args": [
        "--from",
        "thema-pulsar[mcp]",
        "pulsar-mcp"
      ],
      "command": "/Users/eigensoup/.local/bin/uvx"
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx"
    },
    "topos": {
      "args": [
        "topos",
        "mcp"
      ],
      "command": "mcp-compat-wrapper"
    }
  },
  "servers": {
    "lean-ctx": {
      "args": [],
      "command": "/Users/eigensoup/.local/bin/lean-ctx",
      "env": {},
      "type": "stdio"
    },
    "pulsar": {
      "args": [
        "--from",
        "thema-pulsar[mcp]",
        "pulsar-mcp"
      ],
      "command": "/Users/eigensoup/.local/bin/uvx",
      "type": "stdio"
    }
  }
}