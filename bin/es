#!/bin/bash
set -euo pipefail

# bin/es
# Main CLI tool for dotfiles management: install, sync, uninstall, mcps, skills, status, help.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Colors & Formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

print_banner() {
    echo -e "${BOLD}${CYAN}"
    cat << "EOF"
  _____ _____  ____ _____ _____ _____ _     _____ ____ 
 | ____|_   _|/ ___| ____/ ___/ _ \ |   | ____/ ___|
 |  _|   | | | |  _|  _|\___ \ | | | |   |  _| \___ \
 | |___  | | | |_| | |______) | |_| | |___| |___ ___) |
 |_____| |_|  \____|_____|____/\___/|_____|_____|____/ 
                                                       
EOF
    echo -e "${NC}"
}

print_success() { echo -e "  ${GREEN}✓${NC} $1"; }
print_info()    { echo -e "  ${BLUE}ℹ${NC} $1"; }
print_warning() { echo -e "  ${YELLOW}⚠${NC} $1"; }
print_error()   { echo -e "  ${RED}✗${NC} $1"; }
print_step()    { echo -e "\n${BOLD}${PURPLE}➔ $1${NC}"; }

# Ensure bin/es is linked into ~/.local/bin/es
ensure_cli_linked() {
    local target_dir="$HOME/.local/bin"
    local target_bin="$target_dir/es"
    local source_bin="$REPO_ROOT/bin/es"

    if [ ! -d "$target_dir" ]; then
        mkdir -p "$target_dir"
    fi

    if [ -L "$target_bin" ]; then
        local current_link
        current_link=$(readlink "$target_bin" 2>/dev/null || echo "")
        if [ "$current_link" != "$source_bin" ]; then
            rm -f "$target_bin"
            ln -sf "$source_bin" "$target_bin"
        fi
    elif [ ! -f "$target_bin" ]; then
        ln -sf "$source_bin" "$target_bin"
    fi
}

# Helper function to install dotfiles safely (symlink vs hard copy)
install_file() {
    local source="$1" target="$2" label="$3" mode="${4:-symlink}"
    local parent_dir
    parent_dir="$(dirname "$target")"

    if [ ! -d "$parent_dir" ]; then
        mkdir -p "$parent_dir"
    fi

    if [ "$mode" = "hard" ] || [ "$mode" = "copy" ]; then
        if [ -L "$target" ]; then
            print_info "Removing existing symlink for $label..."
            rm "$target"
        elif [ -f "$target" ]; then
            if ! cmp -s "$target" "$source"; then
                local backup="${target}.backup.$(date +%Y%m%d%H%M%S)"
                print_warning "$label differs from repo. Backing up to '$(basename "$backup")'..."
                mv "$target" "$backup"
            fi
        fi
        cp "$source" "$target"
        print_success "Wrote standalone file $label -> $target"
    else
        # Symlink mode
        if [ -L "$target" ]; then
            local resolved
            resolved=$(readlink "$target" 2>/dev/null || echo "")
            if [ "$resolved" = "$source" ]; then
                print_success "$label is already linked correctly."
                return
            else
                print_info "$label link points to '$resolved'. Updating link..."
                rm "$target"
            fi
        elif [ -f "$target" ]; then
            if cmp -s "$target" "$source"; then
                print_info "$label is identical to repo version. Replacing with symlink..."
                rm "$target"
            else
                local backup="${target}.backup.$(date +%Y%m%d%H%M%S)"
                print_warning "$label differs from repo. Backing up to '$(basename "$backup")'..."
                mv "$target" "$backup"
            fi
        fi

        ln -sf "$source" "$target"
        print_success "Linked $label -> $target"
    fi
}

# Interactive TUI feature selection
run_tui() {
    local pre_hard="${1:-0}"
    local labels=(
        "Zsh & Powerlevel10k Configuration (.zshrc, .p10k.zsh)"
        "VS Code Configuration (settings.json & extensions)"
        "Cursor Configuration (settings.json & extensions)"
        "Antigravity IDE Configuration (settings.json & extensions)"
        "MCP Servers Configuration (AGY, Antigravity, Cursor, VS Code, Claude, Copilot)"
        "Agent Skills Management (asm, ponytail & smart-commit)"
        "iTerm2 Preferences Folder Link"
        "Local Secrets File Stub (~/.zsh/secrets.zsh)"
        "Hard Rewrite Mode (Copy files directly to disk instead of symlinking)"
    )
    local selected=(1 1 1 1 1 1 1 1 "$pre_hard")
    local current=0
    local count=${#labels[@]}

    # Check TTY
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        return 0
    fi

    local old_stty
    old_stty=$(stty -g 2>/dev/null || echo "")

    cleanup_tui() {
        if [ -n "$old_stty" ]; then
            stty "$old_stty" 2>/dev/null || true
        fi
        printf "\033[?25h" # Show cursor
    }
    trap cleanup_tui EXIT INT TERM

    stty -echo -icanon min 1 time 0 2>/dev/null || true
    printf "\033[?25l" # Hide cursor

    while true; do
        clear
        print_banner
        echo -e "${BOLD}${CYAN}================================================================${NC}"
        echo -e "${BOLD}${CYAN}  Eigensoup Dotfiles Feature Selection${NC}"
        echo -e "${BOLD}${CYAN}================================================================${NC}"
        echo -e "  ${GREEN}✓ SAFE INSTALL:${NC} All existing configurations are backed up automatically."
        echo -e "  ${DIM}You can revert to your original setup at any time using: ${BOLD}es uninstall${NC}\n"
        echo -e "  ${DIM}Controls: [↑/↓ or k/j] Navigate | [Space] Toggle | [a] Select All | [Enter] Confirm | [q] Quit${NC}\n"

        for i in "${!labels[@]}"; do
            local mark=" "
            if [ "${selected[$i]}" -eq 1 ]; then
                mark="${GREEN}X${NC}"
            fi

            if [ "$i" -eq "$current" ]; then
                echo -e " ${CYAN}➔${NC} [${mark}] ${BOLD}${CYAN}${labels[$i]}${NC}"
            else
                echo -e "   [${mark}] ${labels[$i]}"
            fi
        done

        echo -e "\n${BOLD}${CYAN}================================================================${NC}"

        local key=""
        key=$(dd bs=3 count=1 2>/dev/null || true)

        case "$key" in
            $'\x1b[A'|$'\x1bOA'|k|K) # Up
                current=$(( (current - 1 + count) % count ))
                ;;
            $'\x1b[B'|$'\x1bOB'|j|J) # Down
                current=$(( (current + 1) % count ))
                ;;
            " ") # Space toggle
                if [ "${selected[$current]}" -eq 1 ]; then
                    selected[$current]=0
                else
                    selected[$current]=1
                fi
                ;;
            a|A) # Select / Deselect All
                local all_selected=1
                for s in "${selected[@]}"; do
                    if [ "$s" -eq 0 ]; then
                        all_selected=0
                        break
                    fi
                done
                for i in "${!selected[@]}"; do
                    if [ "$all_selected" -eq 1 ]; then
                        selected[$i]=0
                    else
                        selected[$i]=1
                    fi
                done
                ;;
            ""|$'\n'|$'\r') # Enter
                break
                ;;
            q|Q|$'\x03') # Quit
                echo -e "\n${YELLOW}Installation cancelled by user.${NC}"
                exit 0
                ;;
        esac
    done

    cleanup_tui
    trap - EXIT INT TERM

    # Save selection results into global variables
    OPT_ZSH=${selected[0]}
    OPT_VSCODE=${selected[1]}
    OPT_CURSOR=${selected[2]}
    OPT_ANTIGRAVITY=${selected[3]}
    OPT_MCPS=${selected[4]}
    OPT_SKILLS=${selected[5]}
    OPT_ITERM=${selected[6]}
    OPT_SECRETS=${selected[7]}
    OPT_HARD=${selected[8]}
}

cmd_install() {
    local auto_yes=0
    local hard_mode=0

    for arg in "$@"; do
        case "$arg" in
            -y|--yes|--all) auto_yes=1 ;;
            --hard|--write|--copy|-c) hard_mode=1 ;;
        esac
    done

    OPT_ZSH=1
    OPT_VSCODE=1
    OPT_CURSOR=1
    OPT_ANTIGRAVITY=1
    OPT_MCPS=1
    OPT_SKILLS=1
    OPT_ITERM=1
    OPT_SECRETS=1
    OPT_HARD=$hard_mode

    if [ "$auto_yes" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
        run_tui "$hard_mode"
    fi

    clear
    print_banner
    echo -e "${BOLD}${CYAN}================================================================${NC}"
    if [ "$OPT_HARD" -eq 1 ]; then
        echo -e "${BOLD}${CYAN}  Executing Dotfiles Installation (Hard Rewrite Mode)${NC}"
    else
        echo -e "${BOLD}${CYAN}  Executing Dotfiles Installation (Symlink Mode)${NC}"
    fi
    echo -e "${DIM}  Repository Root: $REPO_ROOT${NC}"
    echo -e "${BOLD}${CYAN}================================================================${NC}"

    # Ensure CLI `es` is linked
    ensure_cli_linked

    local install_mode="symlink"
    if [ "$OPT_HARD" -eq 1 ]; then
        install_mode="hard"
    fi

    # 1. Homebrew dependencies (macOS only)
    if [ "$(uname)" = "Darwin" ]; then
        print_step "Checking Homebrew & System Dependencies..."
        if command -v brew &>/dev/null; then
            if [ -f "$REPO_ROOT/Brewfile" ]; then
                print_info "Bundling packages from Brewfile..."
                brew bundle --file="$REPO_ROOT/Brewfile" || print_warning "Some Brewfile packages failed."
            fi
        else
            print_warning "Homebrew not found. Skipping Brewfile packages."
        fi
    fi

    # 2. Zsh Setup
    if [ "$OPT_ZSH" -eq 1 ]; then
        print_step "Installing Zsh & Powerlevel10k configuration..."
        install_file "$REPO_ROOT/.zshrc" "$HOME/.zshrc" ".zshrc" "$install_mode"
        install_file "$REPO_ROOT/.p10k.zsh" "$HOME/.p10k.zsh" ".p10k.zsh" "$install_mode"
    fi

    # 3. Editor Setup
    if [ "$OPT_VSCODE" -eq 1 ] || [ "$OPT_CURSOR" -eq 1 ] || [ "$OPT_ANTIGRAVITY" -eq 1 ]; then
        print_step "Installing Editor configurations..."
        
        local editor_flags=()
        [ "$OPT_VSCODE" -eq 1 ] && editor_flags+=("--vscode")
        [ "$OPT_CURSOR" -eq 1 ] && editor_flags+=("--cursor")
        [ "$OPT_ANTIGRAVITY" -eq 1 ] && editor_flags+=("--antigravity")
        [ "$OPT_HARD" -eq 1 ] && editor_flags+=("--hard")

        "$REPO_ROOT/bin/setup-editors.sh" "${editor_flags[@]}"
    fi

    # 4. MCP Servers Setup
    if [ "$OPT_MCPS" -eq 1 ]; then
        local mcp_flags=()
        if [ "$OPT_HARD" -eq 1 ]; then
            mcp_flags+=("--hard")
        fi
        if [ ${#mcp_flags[@]} -gt 0 ]; then
            "$REPO_ROOT/bin/setup-mcps.sh" "${mcp_flags[@]}"
        else
            "$REPO_ROOT/bin/setup-mcps.sh"
        fi
    fi

    # 5. Agent Skills Setup (asm, ponytail, smart-commit)
    if [ "$OPT_SKILLS" -eq 1 ]; then
        "$REPO_ROOT/bin/setup-skills.sh"
    fi

    # 6. Secrets Setup
    if [ "$OPT_SECRETS" -eq 1 ]; then
        print_step "Setting up secrets stub..."
        local secrets_dir="$HOME/.zsh"
        local secrets_file="$secrets_dir/secrets.zsh"

        if [ ! -f "$secrets_file" ]; then
            mkdir -p "$secrets_dir"
            cat << 'EOF' > "$secrets_file"
# ==============================================================================
# Local Secrets & API Keys (DO NOT commit to dotfiles repository)
# ==============================================================================

export GITHUB_PERSONAL_ACCESS_TOKEN=""
export GITHUB_PAT="$GITHUB_PERSONAL_ACCESS_TOKEN"

export OPENAI_API_KEY=""
export OPENAI_API_TOKEN="$OPENAI_API_KEY"

export XAI_API_KEY=""
export XAI_API_TOKEN="$XAI_API_KEY"
EOF
            print_success "Created secrets stub at $secrets_file"
        else
            print_info "Secrets file already exists at $secrets_file. Leaving untouched."
        fi
    fi

    # 7. iTerm2 Configuration
    if [ "$OPT_ITERM" -eq 1 ] && [ "$(uname)" = "Darwin" ]; then
        print_step "Configuring iTerm2 Preferences Folder..."
        local expected_folder="$REPO_ROOT/iterm"
        defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$expected_folder"
        defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
        print_success "Linked iTerm2 preferences folder to: $expected_folder"
    fi

    echo -e "\n${BOLD}${CYAN}================================================================${NC}"
    print_success "${BOLD}Installation complete!${NC}"
    print_info "CLI command '${BOLD}es${NC}' is active on your PATH."
    print_info "To revert changes at any time, run: ${BOLD}es uninstall${NC}"
    echo -e "${BOLD}${CYAN}================================================================${NC}\n"
}

cmd_uninstall() {
    "$REPO_ROOT/uninstall.sh" "$@"
}

cmd_sync() {
    print_banner
    echo -e "${BOLD}${CYAN}================================================================${NC}"
    echo -e "${BOLD}${CYAN}  Syncing Dotfiles to Latest Version${NC}"
    echo -e "${DIM}  Repository Root: $REPO_ROOT${NC}"
    echo -e "${BOLD}${CYAN}================================================================${NC}"

    if [ -d "$REPO_ROOT/.git" ]; then
        print_step "Fetching and pulling latest changes from repository..."
        (cd "$REPO_ROOT" && git pull --rebase --autostash) || print_warning "git pull encountered issues, continuing with local sync..."
    else
        print_info "Not a git repository, skipping git pull."
    fi

    print_step "Re-applying configurations..."
    cmd_install --yes "$@"
}

cmd_mcps() {
    "$REPO_ROOT/bin/setup-mcps.sh" "$@"
}

cmd_skills() {
    "$REPO_ROOT/bin/setup-skills.sh" "$@"
}

cmd_status() {
    print_banner
    echo -e "${BOLD}${CYAN}================================================================${NC}"
    echo -e "${BOLD}${CYAN}  Dotfiles Installation & Symlink Status${NC}"
    echo -e "${BOLD}${CYAN}================================================================${NC}"

    local targets=(
        "$HOME/.zshrc:$REPO_ROOT/.zshrc"
        "$HOME/.p10k.zsh:$REPO_ROOT/.p10k.zsh"
        "$HOME/Library/Application Support/Code/User/settings.json:$REPO_ROOT/editors/vscode/settings.json"
        "$HOME/Library/Application Support/Cursor/User/settings.json:$REPO_ROOT/editors/cursor/settings.json"
        "$HOME/Library/Application Support/Antigravity IDE/User/settings.json:$REPO_ROOT/editors/antigravity/settings.json"
        "$HOME/.gemini/antigravity-cli/mcp_config.json:$REPO_ROOT/mcp/mcp_config.json"
        "$HOME/Library/Application Support/Code/User/mcp.json:$REPO_ROOT/mcp/mcp_config.json"
        "$HOME/.cursor/mcp.json:$REPO_ROOT/mcp/mcp_config.json"
        "$HOME/.local/bin/es:$REPO_ROOT/bin/es"
    )

    for entry in "${targets[@]}"; do
        local target="${entry%%:*}"
        local source="${entry#*:}"
        local name
        name="$(basename "$target")"

        if [ -L "$target" ]; then
            local dest
            dest=$(readlink "$target" 2>/dev/null || echo "")
            if [[ "$dest" == "$REPO_ROOT"* ]]; then
                print_success "$name -> $dest (symlink)"
            else
                print_warning "$name -> $dest (external symlink)"
            fi
        elif [ -f "$target" ]; then
            if cmp -s "$target" "$source" 2>/dev/null; then
                print_success "$name (standalone copy, matches repo)"
            else
                print_info "$name (standalone file, modified)"
            fi
        else
            print_error "$name is missing"
        fi
    done

    print_step "Agent Skills Manager (asm) Status..."
    if command -v asm &>/dev/null; then
        print_success "asm is active ($(asm --version 2>/dev/null | head -n 1 || echo "installed"))"
        if [ -d "$HOME/.agents/skills/ponytail" ]; then
            print_success "ponytail skill installed"
        else
            print_warning "ponytail skill missing"
        fi
        if [ -d "$HOME/.agents/skills/smart-commit" ]; then
            print_success "smart-commit skill installed"
        else
            print_warning "smart-commit skill missing"
        fi
    else
        print_error "asm (Agent Skills Manager) is missing"
    fi

    echo -e "${BOLD}${CYAN}================================================================${NC}\n"
}

cmd_help() {
    print_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo -e "  es <command> [options]\n"
    echo -e "${BOLD}COMMANDS:${NC}"
    echo -e "  ${GREEN}install${NC}    Run interactive TUI setup to select and link/write features"
    echo -e "  ${GREEN}sync${NC}       Pull latest changes from git and re-apply all configurations"
    echo -e "  ${GREEN}mcps${NC}       Configure MCP servers across all agent CLIs & editors"
    echo -e "  ${GREEN}skills${NC}     Sync Agent Skills (asm, ponytail & smart-commit) across agents"
    echo -e "  ${GREEN}uninstall${NC}  Safely remove symlinks/standalone copies and restore original backups"
    echo -e "  ${GREEN}status${NC}     Display current symlink, MCP, and agent skill status"
    echo -e "  ${GREEN}help${NC}       Show this help message\n"
    echo -e "${BOLD}OPTIONS:${NC}"
    echo -e "  ${CYAN}-y, --yes, --all${NC}           Non-interactive install (select all features)"
    echo -e "  ${CYAN}-c, --hard, --write, --copy${NC} Hard rewrite mode: copy files directly to disk instead of symlinking\n"
    echo -e "${BOLD}SAFETY GUARANTEE:${NC}"
    echo -e "  All existing configurations are backed up with timestamps."
    echo -e "  You can cleanly revert back to your previous setup at any time using: ${BOLD}es uninstall${NC}\n"
}

# Main Command Dispatcher
COMMAND="${1:-install}"
case "$COMMAND" in
    install)
        shift 1 2>/dev/null || true
        cmd_install "$@"
        ;;
    sync|pull|update)
        shift 1 2>/dev/null || true
        cmd_sync "$@"
        ;;
    mcps|mcp)
        shift 1 2>/dev/null || true
        cmd_mcps "$@"
        ;;
    skills|skill)
        shift 1 2>/dev/null || true
        cmd_skills "$@"
        ;;
    uninstall)
        shift 1 2>/dev/null || true
        cmd_uninstall "$@"
        ;;
    status|list)
        cmd_status
        ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        print_error "Unknown command: $COMMAND"
        cmd_help
        exit 1
        ;;
esac
